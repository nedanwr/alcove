# Copy to `.env` for local development. Matches the defaults in compose.dev.yaml.
DATABASE_URL=postgresql://alcove:alcove@localhost:5432/alcove

# Signs session cookies and encrypts auth data. Required, at least 32 characters.
# Generate one with `openssl rand -base64 32`. Never reuse it across installations.
BETTER_AUTH_SECRET=

# The origin users open Alcove at. Use https:// in production, which also makes cookies Secure.
BETTER_AUTH_URL=http://localhost:3000
