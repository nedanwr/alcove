{
  // Prettier is disabled because OxC handles formatting.
  "prettier.enable": false,

  // Oxfmt formats and Oxlint fixes through the Oxc extension.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][markdown][yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // TanStack Router generates the route tree; keep it out of search and read-only in the editor.
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  }
}
