#!/bin/sh
#
# Formats and lints staged files with Oxfmt and Oxlint via lint-staged.
# Enable with: git config --local core.hooksPath .githooks

# Hooks run from the repository root, but cd anyway so the hook also
# works when invoked directly from a subdirectory.
cd "$(git rev-parse --show-toplevel)" || exit 1

exec pnpm --silent pre-commit
