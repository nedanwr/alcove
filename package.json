{
  "name": "alcove",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @alcove/database db:generate",
    "db:migrate": "pnpm --filter @alcove/database db:migrate",
    "db:check": "pnpm --filter @alcove/database db:check",
    "auth:generate": "pnpm --filter @alcove/core auth:generate",
    "pre-commit": "lint-staged --concurrent false"
  },
  "devDependencies": {
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,css,md,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@12.14.0"
}
